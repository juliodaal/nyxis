---
import { Code } from 'astro:components';
---

<section class="mx-auto max-w-3xl px-6 py-20">
  <header class="flex flex-col gap-3 text-center">
    <span class="text-muted-foreground text-xs font-semibold uppercase tracking-widest">
      Three lines
    </span>
    <h2 class="text-foreground text-3xl font-bold tracking-tight sm:text-4xl">
      Install. Theme. Ship.
    </h2>
  </header>

  <div class="border-border bg-card mt-10 overflow-hidden rounded-xl border">
    <div
      class="border-border bg-muted/30 text-muted-foreground border-b px-4 py-2 font-mono text-xs"
    >
      Terminal
    </div>
    <div class="p-4">
      <Code
        code={`pnpm add nyxis-ui react react-dom tailwindcss\n\n# in your global CSS\n@import 'tailwindcss';\n@import 'nyxis-ui/styles.css';\n\n# anywhere in your app\nimport { Button, ChatMessage, KPICard } from 'nyxis-ui';\n`}
        lang="bash"
        themes={{ light: 'github-light', dark: 'github-dark' }}
      />
    </div>
  </div>
</section>
