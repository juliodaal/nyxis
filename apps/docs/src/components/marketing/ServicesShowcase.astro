---
const services = [
  {
    name: 'DocuMind',
    title: 'Document intelligence',
    description: 'PDF parsing, extraction, validation, and audit-ready logs.',
    components: ['FileDropzone', 'DataTable', 'ConfidenceBadge', 'AuditLogItem'],
    color: 'oklch(0.65 0.2 295)',
  },
  {
    name: 'AskCompany',
    title: 'Internal RAG assistant',
    description: 'Search every doc, return answers with citations.',
    components: ['ChatMessage', 'ChatInput', 'CitationCard', 'Command'],
    color: 'oklch(0.7 0.2 240)',
  },
  {
    name: 'LeadSift',
    title: 'Lead qualification',
    description: 'Enrich, score, and route inbound leads automatically.',
    components: ['LeadCard', 'DataTable', 'KPICard'],
    color: 'oklch(0.7 0.2 200)',
  },
  {
    name: 'SupportDeflect',
    title: 'Customer support',
    description: 'Deflect 30-50% of tickets with a knowledge-grounded agent.',
    components: ['ChatMessage', 'ChatInput', 'SentimentIndicator'],
    color: 'oklch(0.7 0.2 160)',
  },
  {
    name: 'MeetingMind',
    title: 'Meeting intelligence',
    description: 'Transcribe, summarize, extract action items.',
    components: ['ActionItem', 'CitationCard', 'SentimentIndicator'],
    color: 'oklch(0.7 0.2 80)',
  },
  {
    name: 'PulseReport',
    title: 'Automated reporting',
    description: 'What changed last week, why, and what to watch.',
    components: ['KPICard', 'CountUp', 'DataTable'],
    color: 'oklch(0.7 0.2 40)',
  },
  {
    name: 'InboxZero',
    title: 'Email triage',
    description: 'Classify, draft, and route incoming mail.',
    components: ['EmailTriageCard', 'DecryptText'],
    color: 'oklch(0.7 0.2 320)',
  },
];
---

<section class="mx-auto max-w-5xl px-6 py-20">
  <header class="flex flex-col gap-3 text-center">
    <span class="text-muted-foreground text-xs font-semibold uppercase tracking-widest">
      Built for
    </span>
    <h2 class="text-foreground text-3xl font-bold tracking-tight sm:text-4xl">
      AI-powered products
    </h2>
    <p class="text-muted-foreground mx-auto max-w-xl">
      Each service in the portfolio drove the design of specific components. You get the patterns
      ready, not the patterns to figure out.
    </p>
  </header>

  <div class="mt-12 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {
      services.map((service) => (
        <article class="border-border bg-card hover:bg-accent/30 group flex flex-col gap-3 rounded-xl border p-5 transition-colors">
          <div class="flex items-center gap-3">
            <div
              class="grid size-8 place-items-center rounded-md text-white"
              style={`background:${service.color}`}
              aria-hidden="true"
            >
              <span class="text-xs font-bold">{service.name[0]}</span>
            </div>
            <h3 class="text-foreground text-base font-semibold">{service.name}</h3>
          </div>
          <p class="text-foreground text-sm font-medium">{service.title}</p>
          <p class="text-muted-foreground text-sm">{service.description}</p>
          <ul class="mt-2 flex flex-wrap gap-1.5">
            {service.components.map((c) => (
              <li class="border-border bg-background text-muted-foreground rounded-full border px-2 py-0.5 font-mono text-[11px]">
                {c}
              </li>
            ))}
          </ul>
        </article>
      ))
    }
  </div>
</section>
