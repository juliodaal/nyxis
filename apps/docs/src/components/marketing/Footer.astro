---
import { CATEGORIES } from '../../lib/registry';
---

<footer class="border-border bg-background border-t">
  <div class="mx-auto grid max-w-6xl grid-cols-1 gap-10 px-6 py-12 sm:grid-cols-4">
    <div class="flex flex-col gap-3 sm:col-span-2">
      <div class="flex items-center gap-2">
        <div class="bg-primary text-primary-foreground grid size-7 place-items-center rounded-md">
          <span class="text-xs font-bold">N</span>
        </div>
        <span class="text-foreground text-base font-semibold">Nyxis</span>
      </div>
      <p class="text-muted-foreground max-w-sm text-sm">
        A modern React component library for AI-powered products. MIT licensed, public roadmap,
        signed releases.
      </p>
    </div>

    <div>
      <h4 class="text-muted-foreground text-xs font-semibold uppercase tracking-widest">
        Documentation
      </h4>
      <ul class="mt-3 flex flex-col gap-2 text-sm">
        {
          CATEGORIES.map((cat) => (
            <li>
              <a
                href={cat.href}
                class="text-muted-foreground hover:text-foreground transition-colors"
              >
                {cat.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <h4 class="text-muted-foreground text-xs font-semibold uppercase tracking-widest">
        Community
      </h4>
      <ul class="mt-3 flex flex-col gap-2 text-sm">
        <li>
          <a
            href="https://github.com/juliodaal/nyxis"
            class="text-muted-foreground hover:text-foreground transition-colors"
          >
            GitHub
          </a>
        </li>
        <li>
          <a
            href="https://nyxis-storybook.vercel.app"
            class="text-muted-foreground hover:text-foreground transition-colors"
          >
            Storybook
          </a>
        </li>
        <li>
          <a
            href="https://github.com/juliodaal/nyxis/issues"
            class="text-muted-foreground hover:text-foreground transition-colors"
          >
            Issues
          </a>
        </li>
        <li>
          <a
            href="https://github.com/juliodaal/nyxis/blob/main/SECURITY.md"
            class="text-muted-foreground hover:text-foreground transition-colors"
          >
            Security
          </a>
        </li>
      </ul>
    </div>
  </div>

  <div class="border-border border-t">
    <div
      class="text-muted-foreground mx-auto flex max-w-6xl flex-col items-center justify-between gap-2 px-6 py-4 text-xs sm:flex-row"
    >
      <span>© 2026 Julio César Daal · MIT licensed</span>
      <span>
        Built on{' '}
        <a href="https://ui.shadcn.com" class="hover:text-foreground">shadcn/ui</a> ·{' '}
        <a href="https://www.radix-ui.com" class="hover:text-foreground">Radix</a> ·{' '}
        <a href="https://sdk.vercel.ai" class="hover:text-foreground">AI SDK</a>
      </span>
    </div>
  </div>
</footer>
