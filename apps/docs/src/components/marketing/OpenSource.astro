---
/**
 * Open source / built in public section. Surfaces the repo, license,
 * contributing path, and changelog so the project doesn't feel like
 * a vendor product. Pure SSR.
 */
const REPO = 'https://github.com/juliodaal/nyxis';
const LINKS = [
  { label: 'Star on GitHub', href: REPO, primary: true },
  { label: 'Read the changelog', href: `${REPO}/blob/main/packages/ui/CHANGELOG.md` },
  { label: 'Contribute', href: `${REPO}/blob/main/CONTRIBUTING.md` },
  { label: 'Report a security issue', href: `${REPO}/blob/main/SECURITY.md` },
];
---

<section class="border-border/40 border-b">
  <div class="mx-auto flex max-w-5xl flex-col items-center gap-6 px-6 py-24 text-center sm:py-28">
    <span class="text-muted-foreground text-xs font-semibold uppercase tracking-widest">
      Open source · MIT
    </span>
    <h2
      class="text-foreground max-w-2xl text-balance text-3xl font-semibold tracking-tight sm:text-4xl"
    >
      Built in public, free for commercial use.
    </h2>
    <p class="text-muted-foreground max-w-xl text-pretty text-base">
      Nyxis is MIT-licensed and developed in the open. No invite list, no waitlist, no hidden
      pricing tier — every component, recipe, and tool ships under the same license. Pull requests,
      issues, and reviews are all welcome.
    </p>

    <div class="mt-2 flex flex-wrap items-center justify-center gap-3">
      {
        LINKS.map((link) => (
          <a
            href={link.href}
            target="_blank"
            rel="noopener noreferrer"
            class={
              link.primary
                ? 'bg-primary text-primary-foreground focus-visible:ring-ring inline-flex h-10 items-center justify-center rounded-md px-5 text-sm font-medium shadow-sm transition-opacity hover:opacity-90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2'
                : 'border-border bg-background text-foreground hover:bg-muted focus-visible:ring-ring inline-flex h-10 items-center justify-center rounded-md border px-4 text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2'
            }
          >
            {link.label}
          </a>
        ))
      }
    </div>

    <p class="text-muted-foreground mt-2 max-w-md text-pretty text-xs">
      Maintained by <a
        href="https://github.com/juliodaal"
        target="_blank"
        rel="noopener noreferrer"
        class="text-foreground hover:text-brand underline-offset-4 transition-colors hover:underline"
        >Julio César Daal</a
      > and contributors. Star the repo if Nyxis saves you time.
    </p>
  </div>
</section>
