---
import { CATEGORIES, REGISTRY, pathFor } from '../../lib/registry';

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;

const groups = CATEGORIES.map((cat) => ({
  ...cat,
  items: REGISTRY.filter((e) => e.category === cat.id),
}));

function isActive(href: string) {
  return currentPath === href || currentPath.startsWith(`${href}/`);
}
---

<aside
  aria-label="Sidebar navigation"
  class="border-border bg-background sticky top-[--docs-header-height] hidden h-[calc(100dvh-var(--docs-header-height))] w-64 shrink-0 overflow-y-auto border-r lg:block"
>
  <nav class="flex flex-col gap-6 px-4 py-6">
    {
      groups.map((group) => (
        <section class="flex flex-col gap-1">
          <h3 class="text-muted-foreground px-2 pb-1 text-xs font-semibold uppercase tracking-wide">
            {group.label}
          </h3>
          <ul class="flex flex-col gap-0.5">
            {group.items.map((item) => {
              const href =
                item.category === 'getting-started' ? `/docs/${item.slug}` : pathFor(item);
              const active = isActive(href);
              return (
                <li>
                  <a
                    href={href}
                    aria-current={active ? 'page' : undefined}
                    class:list={[
                      'flex items-center justify-between gap-2 rounded-md px-2 py-1.5 text-sm transition-colors',
                      active
                        ? 'bg-accent text-accent-foreground font-medium'
                        : 'text-muted-foreground hover:bg-muted hover:text-foreground',
                    ]}
                  >
                    <span class="truncate">{item.name}</span>
                    {item.status !== 'stable' && (
                      <span
                        class="text-muted-foreground rounded px-1.5 py-0.5 text-[10px] font-medium uppercase tracking-wider"
                        data-status={item.status}
                      >
                        {item.status}
                      </span>
                    )}
                  </a>
                </li>
              );
            })}
          </ul>
        </section>
      ))
    }
  </nav>
</aside>

<style>
  [data-status='planned'] {
    background: oklch(from var(--color-muted) l c h / 0.6);
  }
  [data-status='in-progress'] {
    background: oklch(from var(--color-warning) l c h / 0.2);
    color: var(--color-warning);
  }
  [data-status='beta'] {
    background: oklch(from var(--color-primary) l c h / 0.2);
    color: var(--color-primary);
  }
</style>
