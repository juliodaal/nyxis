---
import { Code } from 'astro:components';
import type { BuiltinLanguage } from 'shiki';
import CopyButton from './CopyButton.tsx';

interface Props {
  code: string;
  lang?: BuiltinLanguage;
  filename?: string;
}

const { code, lang = 'tsx' as BuiltinLanguage, filename } = Astro.props;
---

<figure
  class="not-prose border-border bg-card group relative my-4 overflow-hidden rounded-lg border"
>
  {
    filename && (
      <figcaption class="border-border bg-muted/30 text-muted-foreground flex items-center justify-between border-b px-4 py-2 text-xs font-medium">
        <span class="font-mono">{filename}</span>
      </figcaption>
    )
  }
  <div class="relative">
    <Code code={code} lang={lang} themes={{ light: 'github-light', dark: 'github-dark' }} />
    <div class="absolute right-2 top-2 opacity-0 transition-opacity group-hover:opacity-100">
      <CopyButton client:idle text={code} />
    </div>
  </div>
</figure>

<style is:global>
  /* Shiki dual-theme: respect data-theme on <html>. */
  :root[data-theme='dark'] .astro-code,
  :root[data-theme='dim'] .astro-code,
  :root[data-theme='high-contrast'] .astro-code {
    background-color: var(--shiki-dark-bg) !important;
    color: var(--shiki-dark) !important;
  }
  :root[data-theme='dark'] .astro-code span,
  :root[data-theme='dim'] .astro-code span,
  :root[data-theme='high-contrast'] .astro-code span {
    color: var(--shiki-dark) !important;
  }
  .astro-code {
    padding: 1rem;
    font-size: 0.8125rem;
    line-height: 1.5;
    overflow-x: auto;
  }
</style>
