---
import BaseLayout from './BaseLayout.astro';
import Sidebar from '../components/docs/Sidebar.astro';
import TopBar from '../components/docs/TopBar.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
const currentPath = new URL(Astro.request.url).pathname;
---

<BaseLayout title={`${title} — Nyxis`} description={description}>
  <TopBar />
  <div class="mx-auto flex w-full max-w-7xl">
    <Sidebar currentPath={currentPath} />
    <main class="min-w-0 flex-1 px-6 py-10 lg:px-12">
      <slot />
    </main>
  </div>

  <style is:global>
    .prose-docs {
      max-width: 48rem;
    }
    .prose-docs h1 {
      font-size: clamp(2rem, 4vw, 2.5rem);
      font-weight: 700;
      letter-spacing: -0.02em;
      color: var(--color-foreground);
      margin-bottom: 0.5rem;
    }
    .prose-docs > p:first-of-type {
      color: var(--color-muted-foreground);
      font-size: 1.125rem;
      margin-top: 0;
      margin-bottom: 1.5rem;
    }
    .prose-docs h2 {
      font-size: 1.5rem;
      font-weight: 600;
      letter-spacing: -0.015em;
      color: var(--color-foreground);
      margin-top: 2.5rem;
      margin-bottom: 1rem;
      scroll-margin-top: calc(var(--docs-header-height) + 1rem);
    }
    .prose-docs h3 {
      font-size: 1.125rem;
      font-weight: 600;
      color: var(--color-foreground);
      margin-top: 2rem;
      margin-bottom: 0.5rem;
      scroll-margin-top: calc(var(--docs-header-height) + 1rem);
    }
    .prose-docs p,
    .prose-docs li {
      color: var(--color-muted-foreground);
      line-height: 1.75;
      margin-bottom: 1rem;
    }
    .prose-docs strong {
      color: var(--color-foreground);
      font-weight: 600;
    }
    .prose-docs a {
      color: var(--color-primary);
      text-decoration: underline;
      text-underline-offset: 0.2em;
      text-decoration-thickness: 1px;
    }
    .prose-docs a:hover {
      text-decoration-thickness: 2px;
    }
    .prose-docs ul {
      padding-left: 1.5rem;
      list-style: disc;
    }
    .prose-docs ol {
      padding-left: 1.5rem;
      list-style: decimal;
    }
    .prose-docs blockquote {
      border-left: 3px solid var(--color-primary);
      padding-left: 1rem;
      color: var(--color-muted-foreground);
      font-style: italic;
      margin: 1rem 0;
    }
    .prose-docs code:not(pre code) {
      background: var(--color-muted);
      color: var(--color-foreground);
      padding: 0.125rem 0.375rem;
      border-radius: 0.25rem;
      font-size: 0.875em;
      font-family: var(--font-mono);
    }
    .prose-docs pre,
    .prose-docs .astro-code {
      border: 1px solid var(--color-border);
      border-radius: 0.5rem;
      padding: 1rem;
      overflow-x: auto;
      font-size: 0.8125rem;
      line-height: 1.6;
      margin: 1rem 0;
    }
    .prose-docs table {
      width: 100%;
      margin: 1.5rem 0;
      border-collapse: collapse;
      font-size: 0.875rem;
    }
    .prose-docs thead {
      border-bottom: 1px solid var(--color-border);
    }
    .prose-docs th {
      text-align: left;
      padding: 0.5rem 0.75rem;
      color: var(--color-foreground);
      font-weight: 600;
    }
    .prose-docs td {
      padding: 0.5rem 0.75rem;
      border-bottom: 1px solid var(--color-border);
      color: var(--color-muted-foreground);
    }
    .prose-docs hr {
      border: none;
      border-top: 1px solid var(--color-border);
      margin: 2rem 0;
    }
  </style>
</BaseLayout>
