---
import { getCollection, render } from 'astro:content';
import DocsLayout from '../../layouts/DocsLayout.astro';
import { findEntry } from '../../lib/registry';

export async function getStaticPaths() {
  const entries = await getCollection('text-animations');
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const registryEntry = findEntry('text-animations', entry.id);
---

<DocsLayout title={entry.data.title} description={entry.data.description}>
  <article class="prose-docs">
    <header class="mb-8 flex flex-col gap-2">
      <div
        class="text-muted-foreground flex items-center gap-2 text-xs font-semibold uppercase tracking-widest"
      >
        <span>Text animations</span>
        {
          registryEntry?.status && registryEntry.status !== 'stable' && (
            <span class="bg-muted rounded px-1.5 py-0.5 text-[10px] tracking-wider">
              {registryEntry.status}
            </span>
          )
        }
      </div>
      <h1>{entry.data.title}</h1>
      <p class="!text-muted-foreground !mb-0 text-base">{entry.data.description}</p>
    </header>
    <Content />
  </article>
</DocsLayout>
