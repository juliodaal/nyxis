{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "baseUrl": ".",
    "paths": {
      "@/components/nyxis/*": ["./registry/components/*"],
      "@/*": ["./src/*"]
    },
    "verbatimModuleSyntax": true,
    "noUncheckedIndexedAccess": true
  },
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": [
    "dist",
    ".astro",
    "registry/api/**",
    "registry/api-astro/**",
    "registry/api-sveltekit/**",
    "registry/api-hono/**",
    "registry/api-express/**",
    "registry/lib/ai/**"
  ]
}
