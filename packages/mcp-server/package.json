{
  "name": "@nyxis/mcp-server",
  "version": "0.2.0",
  "description": "MCP server that exposes the Nyxis registry to AI coding assistants (Claude Code, Cursor, Windsurf, etc.).",
  "license": "MIT",
  "author": "Julio César Daal <juliocesar.daal@gmail.com>",
  "homepage": "https://nyxis.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/juliodaal/nyxis.git",
    "directory": "packages/mcp-server"
  },
  "bugs": {
    "url": "https://github.com/juliodaal/nyxis/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "nyxis",
    "claude-code",
    "cursor",
    "windsurf",
    "ai"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "nyxis-mcp": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "dev": "tsup --watch --no-dts",
    "build": "tsup",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsup": "^8.3.5",
    "typescript": "catalog:"
  }
}
