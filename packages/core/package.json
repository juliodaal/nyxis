{
  "name": "@nyxis/core",
  "version": "0.2.0",
  "description": "Runtime core for Nyxis — types, provider adapter, event bus, and React hooks for AI products.",
  "license": "MIT",
  "author": "Julio César Daal <juliocesar.daal@gmail.com>",
  "homepage": "https://nyxis-docs.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/juliodaal/nyxis.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/juliodaal/nyxis/issues"
  },
  "keywords": [
    "ai",
    "ai-sdk",
    "react",
    "anthropic",
    "openai",
    "google",
    "mistral",
    "ollama",
    "chat",
    "agents",
    "rag",
    "mcp"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "dev": "tsup --watch --no-dts",
    "build": "tsup",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke:providers": "tsx scripts/smoke-providers.ts"
  },
  "peerDependencies": {
    "@ai-sdk/anthropic": "^1.0.0 || ^2.0.0",
    "@ai-sdk/google": "^1.0.0 || ^2.0.0",
    "@ai-sdk/mistral": "^1.0.0 || ^2.0.0",
    "@ai-sdk/openai": "^1.0.0 || ^2.0.0",
    "ai": "^4.0.0 || ^5.0.0",
    "ollama-ai-provider": "^1.0.0 || ^2.0.0",
    "react": "^18 || ^19"
  },
  "peerDependenciesMeta": {
    "@ai-sdk/anthropic": {
      "optional": true
    },
    "@ai-sdk/google": {
      "optional": true
    },
    "@ai-sdk/mistral": {
      "optional": true
    },
    "@ai-sdk/openai": {
      "optional": true
    },
    "ai": {
      "optional": true
    },
    "ollama-ai-provider": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ai-sdk/anthropic": "^1.1.0",
    "@ai-sdk/google": "^1.1.0",
    "@ai-sdk/mistral": "^1.1.0",
    "@ai-sdk/openai": "^1.1.0",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/react": "catalog:",
    "ai": "^4.1.0",
    "jsdom": "catalog:",
    "ollama-ai-provider": "^1.2.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
