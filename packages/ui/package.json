{
  "name": "nyxis-ui",
  "version": "0.19.0",
  "description": "Theme system for the Nyxis ecosystem. Components are distributed via the shadcn registry; install them with `npx shadcn@latest add @nyxis/<name>`.",
  "license": "MIT",
  "author": "Julio César Daal <juliocesar.daal@gmail.com>",
  "homepage": "https://nyxisai.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/juliodaal/nyxis.git",
    "directory": "packages/ui"
  },
  "bugs": {
    "url": "https://github.com/juliodaal/nyxis/issues"
  },
  "keywords": [
    "react",
    "tailwindcss",
    "theme",
    "design-tokens",
    "ai",
    "nyxis"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "./dist/styles.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./theme": {
      "types": "./dist/components/theme/index.d.ts",
      "import": "./dist/components/theme/index.js"
    },
    "./utils": {
      "types": "./dist/lib/utils.d.ts",
      "import": "./dist/lib/utils.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "dev": "tsup --watch --no-dts",
    "build": "tsup",
    "build:css": "node scripts/copy-styles.mjs",
    "build:directives": "node scripts/preserve-directives.mjs",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "publint": "publint",
    "attw": "attw --pack ."
  },
  "peerDependencies": {
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19",
    "tailwindcss": "^4.0.0"
  },
  "dependencies": {
    "clsx": "catalog:",
    "tailwind-merge": "catalog:"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.3",
    "@tailwindcss/cli": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "jsdom": "catalog:",
    "publint": "^0.3.2",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "catalog:",
    "tsup": "^8.3.5",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
